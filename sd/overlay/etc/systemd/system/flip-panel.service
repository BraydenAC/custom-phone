[Unit]
Description=Start the screen (its panel config file is on the root file system)
# The panel driver is built into the kernel and probes before the root file
# system is mounted, so it can't find /usr/lib/firmware/<panel>.bin and gives
# up. Bind it again now: the kernel mounted / before starting systemd, so the
# file is there. (Not After=local-fs.target: that also waits for /boot on the
# card, which comes much later, and the startup animation needs the screen.)
# Only one of the two panel variants is fitted; binding the other one fails,
# which is fine.
DefaultDependencies=no
# The startup animation first takes tty1 off the screen (if it's enabled).
After=flip-splash.service
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for d in spi0.0 spi0.1; do [ -e /sys/bus/spi/devices/$d/driver ] || echo $d > /sys/bus/spi/drivers/panel-mipi-dbi-spi/bind 2>/dev/null; done; true'

[Install]
WantedBy=sysinit.target
