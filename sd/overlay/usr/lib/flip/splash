#!/usr/bin/python3
"""Startup and shutdown animations on the phone's screen (hexagons, orange/black).

Startup: black hexagons spread over orange, following real startup steps
(systemd units, STEPS below); when the system has finished starting, a ripple
runs through them, "READY" shows, and the screen goes back to the text console.

Shutdown (--shutdown poweroff|reboot, flip-splash-shutdown@.service): orange
hexagons go dark one by one in a random, spread-out order. The last ones wait
until every service has stopped. Then "RESTARTING", or for a power-off "OFF" --
after "UNPLUG USB" if a cable is delivering power (powering off while plugged
in crashes this phone), for at most `unplug_wait` seconds.

Settings: /etc/flip/splash.conf (see STYLES / DEFAULTS).
Try them any time:  /usr/lib/flip/splash --demo 14
                    /usr/lib/flip/splash --shutdown poweroff --demo 3
"""

import array
import configparser
import fcntl
import math
import mmap
import os
import signal
import socket
import subprocess
import sys
import threading
import time

CONFIG = "/etc/flip/splash.conf"
FB = "/dev/fb0"
FB_SYS = "/sys/class/graphics/fb0"
TTY = "/dev/tty1"
SPLASH_PID = "/run/flip-splash.pid"  # the screen manager leaves the screen alone meanwhile
KDSETMODE, KDGETMODE, KD_TEXT, KD_GRAPHICS = 0x4B3A, 0x4B3B, 0x00, 0x01
FBIOGET_VSCREENINFO, FBIOPUT_VSCREENINFO, FBIOBLANK = 0x4600, 0x4601, 0x4611
FB_VAR_SIZE, FB_VAR_ACTIVATE, FB_ACTIVATE_FORCE, FB_BLANK_UNBLANK = 160, 84, 0x80, 0

# bloom: hexagons grow from the centre to the edges. rise: they fill the
# screen from the bottom up.
STYLES = ("bloom", "rise")
DEFAULTS = {"style": "bloom", "hex_size": "15", "step_names": "yes", "hold": "2",
            "fps": "15", "shutdown_length": "3", "unplug_wait": "8"}
SHUTDOWN_KINDS = ("poweroff", "reboot")
SHUTDOWN_GAP = 0.2  # seconds of black between the last hexagon and the message
POWER_SUPPLIES = "/sys/class/power_supply"

# (label, unit that is active once the step is done). Order = display order.
STEPS = [
    ("STORAGE", "local-fs.target"),
    ("USB LINK", "flipd.service"),
    ("WI-FI", "NetworkManager.service"),
    ("AUDIO", "sound.target"),
    ("MODEM", "ModemManager.service"),
]

ORANGE, ORANGE_DARK, ORANGE_LIGHT, BLACK = 0xFF7300, 0xE25F00, 0xFF9A40, 0x000000

